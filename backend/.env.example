NODE_ENV=production
PORT=3001

# Wajib diisi kalau ingin jawaban AI sungguhan.
# Jika kosong, backend tetap berjalan dengan fallback generator lokal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.35

# Isi dengan domain Vercel Anda setelah deploy.
# Contoh: https://bmc-psi-two.vercel.app,http://localhost:5500
CORS_ORIGIN=

# Opsional. Jika diisi, frontend harus mengirim header x-app-key.
# Catatan: key yang dipasang di frontend tetap bisa dilihat user, jadi ini hanya proteksi ringan.
APP_API_KEY=

# Biarkan true agar API tetap mengembalikan hasil fallback saat OpenAI error.
AI_FALLBACK_TO_LOCAL=true
# Folder penyimpanan knowledge base dan social queue lokal.
# Default: backend/data
BMC_DATA_DIR=

# Social publisher MVP.
# mock = jadwal dianggap published tanpa memanggil platform.
# live = coba publisher yang sudah dikonfigurasi tokennya.
SOCIAL_PUBLISH_MODE=mock
X_USER_TOKEN=