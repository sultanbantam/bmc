NODE_ENV=production
PORT=3001

# Wajib diisi kalau ingin jawaban AI sungguhan.
# Jika kosong, backend tetap berjalan dengan fallback generator lokal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.35

# Isi dengan domain Vercel Anda setelah deploy.
# Contoh: https://bmc-psi-two.vercel.app,http://localhost:5500
CORS_ORIGIN=

# Opsional. Jika diisi, frontend harus mengirim header x-app-key.
# Catatan: key yang dipasang di frontend tetap bisa dilihat user, jadi ini hanya proteksi ringan.
APP_API_KEY=

# Wajib untuk admin Knowledge Base. Jangan dipasang di config.js publik.
# Admin memasukkan key ini lewat URL ?admin=1 di browser.
ADMIN_API_KEY=

# Biarkan true agar API tetap mengembalikan hasil fallback saat OpenAI error.
AI_FALLBACK_TO_LOCAL=true
# Folder penyimpanan knowledge base dan social queue lokal.
# Default: backend/data
BMC_DATA_DIR=

# Social publisher MVP.
# mock = jadwal dianggap published tanpa memanggil platform.
# live = publish sungguhan untuk platform yang sudah punya token resmi.
SOCIAL_PUBLISH_MODE=mock

# Aktifkan worker otomatis untuk memproses jadwal yang sudah due.
# Jika false, publish due hanya berjalan saat endpoint /api/social/publish-due dipanggil.
SOCIAL_AUTO_PUBLISH=false
SOCIAL_PUBLISH_INTERVAL_MS=300000

# Untuk tahap pertama, live publishing hanya diaktifkan untuk X.
SOCIAL_LIVE_PLATFORMS=X

# X / Twitter OAuth 2.0 user token dengan permission tweet.write.
X_USER_TOKEN=
X_TEXT_LIMIT=280